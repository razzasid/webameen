# Copy to .env.local for local development.
# Set these values to the local Supabase API URL and publishable key to use auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for the narrowly scoped quotation token broker.
# Use your local Supabase secret key; never expose this as NEXT_PUBLIC_*.
SUPABASE_QUOTE_BROKER_KEY=
# Server-only key for fixed invoice token reads; never expose this as NEXT_PUBLIC_*.
SUPABASE_INVOICE_BROKER_KEY=
# Public site origin used only as the email-confirmation callback base.
# Hosted deployments must set this to the exact allowed HTTPS site URL.
APP_URL=http://127.0.0.1:3000
