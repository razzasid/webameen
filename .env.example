# Copy to .env.local for local development.
# Set these values to the local Supabase API URL and publishable key to use auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for the narrowly scoped quotation token broker.
# Use your local Supabase secret key; never expose this as NEXT_PUBLIC_*.
SUPABASE_QUOTE_BROKER_KEY=
# Server-only key for fixed invoice token reads; never expose this as NEXT_PUBLIC_*.
SUPABASE_INVOICE_BROKER_KEY=
# Service role key or worker key for background reminder scheduler
SUPABASE_SERVICE_ROLE_KEY=
# Secret bearer token to protect the scheduled background trigger /api/reminders/process
CRON_SECRET=

# Communication Providers for Automated Reminders:
# 1. Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Webameen Invoicing <invoicing@example.com>

# 2. WhatsApp & SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155238886

# 3. Meta WhatsApp Cloud API (Alternative for WhatsApp)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Public site origin used only as the email-confirmation callback base.
# Hosted deployments must set this to the exact allowed HTTPS site URL.
APP_URL=http://127.0.0.1:3000
WEBAMEEN_PUBLIC_CATALOG_READS_PER_MINUTE=60